<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Exemplo</RootNamespace>
    <AssemblyName>Exemplo</AssemblyName>
    <!-- Pasta do Canis Major. Troque se a engine mudar de lugar. -->
    <CanisMajorRoot Condition="'$(CanisMajorRoot)' == ''">$(MSBuildThisFileDirectory)..\..</CanisMajorRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CanisMajorRoot)\src\CanisMajor\CanisMajor.csproj" />
    <Content Include="projeto.json;sprites\**;rooms\**;shaders\**;sounds\**;objects\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ao exportar (cm export ou Exportar jogo no editor): um .exe só, sem janela de console. -->
  <PropertyGroup Condition="'$(CanisExport)' == 'true'">
    <OutputType>WinExe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\canis.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <Product>Canis Major</Product>
    <AssemblyTitle>Canis Major</AssemblyTitle>
    <Description>Editor da engine de jogos Canis Major</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\canis.ico" />
    <!-- As tabelas do Emmet e os atalhos do VS Code, as duas sob a licença MIT, com os textos ao lado. -->
    <EmbeddedResource Include="Assets\Snippets\*.json;Assets\Snippets\*.code-snippets" LogicalName="Snippets.%(Filename)%(Extension)" />
    <None Include="Assets\Snippets\LICENSE-*.txt" CopyToOutputDirectory="PreserveNewest" Link="Licencas\%(Filename)%(Extension)" />
    <!-- Os ícones de arquivo do Material Icon Theme, licença MIT. -->
    <EmbeddedResource Include="Assets\FileIcons\icons.json" LogicalName="FileIcons.icons.json" />
    <None Include="Assets\FileIcons\LICENSE-*.txt" CopyToOutputDirectory="PreserveNewest" Link="Licencas\%(Filename)%(Extension)" />
    <!-- O editor nasceu do código da IDE Sirius, de Erick Fuzer, sob a licença MIT. -->
    <None Include="LICENSE-Sirius.txt" CopyToOutputDirectory="PreserveNewest" Link="Licencas\LICENSE-Sirius.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- O leitor de C# da Microsoft, para converter o script em blocos e de volta. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- O formato dos projetos de jogo, os modelos e a conferência de shaders (canis_core.dll) vêm da engine. -->
    <ProjectReference Include="..\CanisMajor\CanisMajor.csproj" />
  </ItemGroup>
</Project>

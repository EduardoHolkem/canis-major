<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CanisMajor</RootNamespace>
    <Version>0.3.0</Version>
    <Description>Canis Major: engine de jogos 2D com núcleo em Rust (wgpu) e jogos em C#.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- O núcleo pronto que vem no pacote da engine (native\) ou o compilado pelo Cargo, no repositório. -->
    <CanisCoreDll>$(MSBuildThisFileDirectory)..\..\native\canis_core.dll</CanisCoreDll>
    <CanisCoreDll Condition="!Exists('$(CanisCoreDll)')">$(MSBuildThisFileDirectory)..\..\core\target\release\canis_core.dll</CanisCoreDll>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CanisMajor.Tests" />
    <None Include="$(CanisCoreDll)" Link="canis_core.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="ConferirNucleo" BeforeTargets="Build" Condition="!Exists('$(CanisCoreDll)')">
    <Error Text="O núcleo em Rust ainda não foi compilado. Rode: cargo build --release, na pasta core." />
  </Target>

</Project>
